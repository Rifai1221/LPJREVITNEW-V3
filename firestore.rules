rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all (Zero Trust Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reject all access to legacy / app-wide configurations
    match /app_settings/{document=**} {
      allow read, write: if false;
    }

    // 3. User-specific Preferences (users/{userId}/prefs/{document=**})
    match /users/{userId}/prefs/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // 4. User School Memberships (users/{userId}/memberships/{schoolId})
    // Used for the "Switch Sekolah" feature: read-only for owner, update ONLY lastOpenedAt
    match /users/{userId}/memberships/{schoolId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastOpenedAt']);
      allow create, delete: if false; // Membership creation/deletion exclusively via Cloud Functions
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(schoolId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid))
        && (!('status' in get(/databases/$(database)/documents/schools/$(schoolId)).data)
            || get(/databases/$(database)/documents/schools/$(schoolId)).data.status != 'deleted');
    }

    function getMemberRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/members/$(request.auth.uid)).data.role;
    }

    function isBendahara(schoolId) {
      return isMember(schoolId) && getMemberRole(schoolId) == 'BENDAHARA';
    }

    function isTimTeknis(schoolId) {
      return isMember(schoolId) && getMemberRole(schoolId) == 'TIM_TEKNIS';
    }

    function isKepalaSekolah(schoolId) {
      return isMember(schoolId) && getMemberRole(schoolId) == 'KEPALA_SEKOLAH';
    }

    function isFasilitator(schoolId) {
      return isMember(schoolId) && getMemberRole(schoolId) == 'FASILITATOR';
    }

    // 5. School Tenant Management
    match /schools/{schoolId} {
      // Only active members of this school can get its metadata.
      // List is disallowed to prevent enumerating all schools in the system.
      allow get: if isMember(schoolId);
      allow list: if false;

      // School creation and deletion are handled exclusively by Cloud Functions
      allow create: if false;
      allow delete: if false;

      // BENDAHARA can update non-security metadata only
      allow update: if isBendahara(schoolId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'createdAt', 'deletedAt', 'purgeAfter',
          'pinHash', 'pinSalt', 'algo', 'failedAttempts', 'lockedUntil', 'npsn'
        ]);

      // 5a. Private security credentials (pinHash, pinSalt, algo, throttling)
      // Strictly inaccessible by all clients; Cloud Functions / Admin SDK only.
      match /private/{docId} {
        allow read, write: if false;
      }

      // 5b. School Members & Roles (schools/{schoolId}/members/{uid})
      // Read-only for school members. Writes strictly via Cloud Functions.
      match /members/{memberUid} {
        allow read: if isMember(schoolId);
        allow write: if false;
      }

      // 5c. LPJ Application Data (schools/{schoolId}/lpj_data/{dataId})
      match /lpj_data/{dataId} {
        // Members can read LPJ data
        allow read: if isMember(schoolId);

        // Create only by BENDAHARA, and 'current' is deprecated (legacy read-only)
        allow create: if isBendahara(schoolId) && dataId != 'current';

        // Delete is disabled for clients (managed via Cloud Functions)
        allow delete: if false;

        // Tiered RBAC updates with MANDATORY rev increment:
        // - 'current' document is immutable legacy
        // - rev MUST increment by exactly 1
        // - BENDAHARA: Full update access
        // - TIM_TEKNIS: Progress, Wages, and Workers only
        // - KEPALA_SEKOLAH: Approval & Status only
        // - FASILITATOR: Read-only (forbidden to mutate)
        allow update: if dataId != 'current'
          && ('rev' in request.resource.data)
          && ('rev' in resource.data)
          && request.resource.data.rev == resource.data.rev + 1
          && (
            isBendahara(schoolId) ||
            (isTimTeknis(schoolId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progressWeeks', 'wageReports', 'workers', 'rev', 'updatedAt', 'updatedBy'])) ||
            (isKepalaSekolah(schoolId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approval', 'approvalKepalaSekolah', 'status', 'catatanKepalaSekolah', 'rev', 'updatedAt', 'updatedBy']))
          );
      }

      // 5d. Snapshots (schools/{schoolId}/snapshots/{snapshotId})
      // Daily snapshot copies of lpj_data. Read by Bendahara, write: false for clients.
      match /snapshots/{snapshotId} {
        allow read: if isBendahara(schoolId);
        allow write: if false;
      }

      // 5e. Audit Logs (schools/{schoolId}/auditLogs/{logId})
      // Append-only by members. Update and delete forbidden.
      match /auditLogs/{logId} {
        allow read: if isMember(schoolId);
        allow create: if isMember(schoolId);
        allow update, delete: if false;
      }
    }
  }
}
